{% extends 'base.html.twig' %}
{% block body %}
<div data-controller="monitor" data-monitor-enabled-value="{{ hasKey ? 'true' : 'false' }}">
    <div class="heading"><h1>Air quality <span>{{ zip }}</span></h1></div>
    <div data-monitor-target="results" aria-live="polite">{% include '_observations.html.twig' %}</div>
    {% if hasKey %}
        <form action="{{ path('refresh') }}" method="post" data-monitor-target="form" data-action="submit->monitor#manual">
            <input type="hidden" name="_token" value="{{ csrf_token('refresh') }}">
            <input type="hidden" name="force" value="1">
            <button data-monitor-target="button">Refresh now</button>
        </form>
        <p class="muted small" data-monitor-target="status">Checks every five minutes while this page is open. API responses are cached for one hour.</p>
    {% endif %}
</div>
{% endblock %}
