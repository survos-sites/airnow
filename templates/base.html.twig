<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Air Quality{% endblock %}</title>
    {{ importmap('app') }}
</head>
<body>
<header><a class="brand" href="{{ path('home') }}">◒ Air Quality</a><span class="eyebrow">AIRNOW</span></header>
<nav aria-label="Main navigation">
    {% for route, label in {home: 'Now', history: 'History', settings: 'Settings'} %}
        <a href="{{ path(route) }}" {% if app.current_route == route %}aria-current="page"{% endif %}>{{ label }}</a>
    {% endfor %}
</nav>
<main>
    {% for message in app.flashes('notice') %}<p class="notice" role="status">{{ message }}</p>{% endfor %}
    {% block body %}{% endblock %}
</main>
<footer>Observations from AirNow · Stored on this Mac</footer>
</body>
</html>
